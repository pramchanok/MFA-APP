{
  "name": "mfa-sync-cloudflare",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "test": "node --test --test-concurrency=1 worker.test.mjs",
    "test:native": "node native-integration.mjs",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:local": "wrangler d1 migrations apply mfa-sync --local",
    "db:remote": "wrangler d1 migrations apply mfa-sync --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
