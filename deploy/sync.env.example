# Copy to the repository root as .env (gitignored). Generate your own value; never reuse an example token.
SYNC_REGISTRATION_TOKEN=
SYNC_PORT=8787
# Set a DNS hostname before enabling the optional tls profile.
SYNC_DOMAIN=sync.example.com
SYNC_MAX_VAULTS=1000
SYNC_MAX_RECORDS_PER_VAULT=100000
SYNC_MAX_BYTES_PER_VAULT=67108864
SYNC_MAX_TOTAL_BYTES=1073741824
# Counted independently per IP and vault. Caddy connections share the proxy IP bucket.
SYNC_RATE_LIMIT_PER_MINUTE=120
