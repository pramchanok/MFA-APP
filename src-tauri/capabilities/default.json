{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "platforms": ["windows", "macOS", "linux"],
  "description": "Local main window: select backup files and deliberately install signed updates.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
